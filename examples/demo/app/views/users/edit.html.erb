<% user = @user.not_nil! %>
<div class="panel" style="max-width: 520px">
  <h1>Profile</h1>
  <div class="sub">Changing email or password goes through devise.cr's
     update_with_password: the current password is required; leave the new
     password blank to keep it unchanged.</div>
<% unless user.errors.empty? %>
  <div class="errors">
    Could not save:
    <ul>
    <% user.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>
  <%= form_with model: user, url: profile_path, method: :patch, class: "stack" do |f| %>
    <div class="field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name %>
    </div>
    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email %>
    </div>
    <div class="field">
      <%= f.label :current_password, "Current password" %>
      <%= f.password_field :current_password, placeholder: "required to save changes" %>
    </div>
    <div class="field">
      <%= f.label :password, "New password" %>
      <%= f.password_field :password, placeholder: "leave blank to keep current" %>
      <div class="hint">At least 6 characters</div>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "New password confirmation" %>
      <%= f.password_field :password_confirmation %>
    </div>
    <%= f.submit "Save", class: "btn primary" %>
  <% end %>
</div>
