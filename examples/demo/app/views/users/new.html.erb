<% user = @user.not_nil! %>
<div class="panel" style="max-width: 460px; margin: 4vh auto">
  <h1>Sign up</h1>
  <div class="sub">Validations come from devise validatable: email format, uniqueness, password length 6–128.</div>
<% unless user.errors.empty? %>
  <div class="errors">
    Please fix these fields:
    <ul>
    <% user.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>
  <%= form_with model: user, url: signup_path, class: "stack" do |f| %>
    <div class="field">
      <%= f.label :name, "Name" %>
      <%= f.text_field :name, placeholder: "Jane" %>
    </div>
    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, placeholder: "you@example.com" %>
    </div>
    <div class="field">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, placeholder: "at least 6 characters" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Password confirmation" %>
      <%= f.password_field :password_confirmation %>
    </div>
    <%= f.submit "Create account", class: "btn primary" %>
  <% end %>
  <div class="auth-alt">Already have an account? <a href="<%= new_user_session_path %>">Sign in</a></div>
</div>
