<% note = @note.not_nil! %>
<a class="backlink" href="<%= notes_path %>">← All notes</a>
<div class="panel wide article c-<%= note.color_class %>">
  <span class="strip"></span>
  <h1><%= note.title %></h1>
  <div class="meta">
    <span><%= (note.created_at || Time.utc).to_s("%d.%m.%Y") %></span>
    <span><%= note.views %> views</span>
  </div>
  <div class="body"><%= note.body %></div>
  <div class="actions">
    <%= button_to note_path(note), method: "delete", class: "btn danger",
          data: {"confirm" => "Delete note \"#{note.title}\"?"} do %>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 6h14M8 6V4h4v2m-7 0 1 11h8l1-11M8.5 9.5v5M11.5 9.5v5"/></svg>
      Delete
    <% end %>
  </div>
</div>
