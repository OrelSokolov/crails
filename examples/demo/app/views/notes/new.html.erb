<% note = @note.not_nil! %>
<a class="backlink" href="<%= notes_path %>">← All notes</a>
<div class="article">
  <h1>New note</h1>
  <div class="meta">Model validations work like Rails: presence and length are enforced by active_record.cr</div>
<% unless note.errors.empty? %>
  <div class="errors" style="margin-top: 22px">
    Could not save the note:
    <ul>
    <% note.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>
  <div style="height: 26px"></div>
  <%= form_with model: note, class: "stack" do |f| %>
    <div class="field">
      <%= f.label :title, "Title" %>
      <%= f.text_field :title, maxlength: 140, placeholder: "What is this note about?", autofocus: true %>
    </div>
    <div class="field">
      <%= f.label :body, "Text" %>
      <%= f.text_area :body, placeholder: "Write freely…" %>
    </div>
    <div class="field">
      <label>Color</label>
      <div class="swatches">
        <% Note::COLORS.each do |color| %>
          <label><%= f.radio_button :color, color %><span class="sw sw-<%= color %>"></span></label>
        <% end %>
      </div>
    </div>
    <%= f.submit "Create note", class: "btn primary" %>
  <% end %>
</div>
